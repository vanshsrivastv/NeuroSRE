# Copy this file to .env and fill in your key.

# groq (recommended, free tier) | anthropic | offline (rule-based, no internet needed)
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# used automatically if the main model hits its rate limit (it has a separate quota)
GROQ_BACKUP_MODEL=openai/gpt-oss-20b
# low = fewer hidden reasoning tokens: faster, and the free daily quota lasts longer
GROQ_REASONING_EFFORT=low

# Only needed if LLM_PROVIDER=anthropic (also: pip install langchain-anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Agent behaviour
RETRIEVAL_TOP_K=3
MAX_ATTEMPTS=3

# Simulator
TICK_SECONDS=2
AUTO_FAULT_EVERY_SECONDS=45
